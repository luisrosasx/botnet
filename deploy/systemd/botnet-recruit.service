# Orquestador del reclutamiento. Un solo proceso manda el ritmo y sirve el
# healthcheck en 9110. restart siempre y sin limite de arranques: un
# crash-loop no debe dejarlo en `failed` (A2-05).
[Unit]
Description=Orquestador de reclutamiento BOT.NET
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
Slice=recruit.slice
EnvironmentFile=/etc/botnet-recruit/env
ExecStartPre=/usr/local/bin/recruit-preflight
ExecStart=/usr/local/bin/botnet-recruit --db-pool=2
Restart=always
RestartSec=5
# Sin sd_notify el watchdog de systemd mata el proceso cada 30 s aunque
# este sano: el latido que se vigila es `tick_at` y lo publica /healthz.
# Se queda como red de seguridad a 120 s, por encima de cualquier tick.
WatchdogSec=120
TimeoutStopSec=20
KillMode=control-group
CPUQuota=150%
MemoryMax=512M
TasksMax=128
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
