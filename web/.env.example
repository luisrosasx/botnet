# Entornos del panel BOT.NET (EP-11). Copia a .env.local y rellena.
# Sin secretos reales versionados: cero lineas de clave live de Stripe.

# API real del backend (server-side para SSR y client-side para el panel)
BOTNET_API_URL=http://127.0.0.1:8080
NEXT_PUBLIC_BOTNET_API_URL=http://127.0.0.1:8080

# Token de operaciones para rutas admin (el default de desarrollo)
BOTNET_ADMIN_TOKEN=dev-admin-token

# E2E smoke: URL del panel en marcha (next start) y slug de dueno
# E2E_WEB_URL=http://127.0.0.1:3100
# E2E_SLUG=panel4demo0x
